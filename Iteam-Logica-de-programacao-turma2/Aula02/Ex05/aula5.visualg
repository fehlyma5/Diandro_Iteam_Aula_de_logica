algoritmo "aula5"
// Disciplina   : Lógica de Programação
// Descrição    : Lê um número e informa se ele é positivo, negativo ou zero.
// Aluno        : Diandro Felipe
// Professora   : Helida Batista

var
   numero: real

inicio
   // Solicita o número ao usuário
   escreva("Digite um número: ")
   leia(numero)
   
   // Estrutura de seleção composta (iniciamos verificando se o numero é positivo, na sequencia se é negativo, e por fim se ele é  neutro)
   se (numero > 0) entao
      escreval("O número ", numero, " é POSITIVO.")
   senao
      se (numero < 0) entao
         escreval("O número ", numero, " é NEGATIVO.")
      senao
         escreval("O número digitado é ZERO (neutro).")
      fimse
   fimse

fimalgoritmo
